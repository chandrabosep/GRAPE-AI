# What `vercel deploy` from a developer's machine must not upload.
#
# A git-triggered deploy clones the repository, so it never sees any of this and
# this file changes nothing for it. A CLI deploy uploads the working directory
# as it stands, which in a pnpm monorepo means the 3 GB of node_modules and the
# 1.5 GB of .next that are already sitting there — together past Vercel's 2 GB
# limit, so the deploy fails before a single file is built.
#
# Everything listed here is either reinstalled by `installCommand` or rebuilt by
# `buildCommand` on the build machine, so excluding it costs nothing.

# Reinstalled by `pnpm install --frozen-lockfile`.
node_modules/
.pnpm-store/

# Rebuilt by `pnpm run build`.
.next/
.turbo/
dist/
out/
build/
*.tsbuildinfo

# Regenerated by `pnpm --filter @aam/db db:generate`.
packages/db/generated/
**/generated/prisma/

# Local-only state that has no meaning on a build machine.
.pglite/
.git/
coverage/
.vitest/
*.vsix
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Secrets live in the project's environment variables, never in the upload.
.env
.env.*
!.env.example
.vercel
