{
  "name": "ai-attention-marketplace",
  "displayName": "GRAPE AI",
  "description": "AI coding assistant where relevant sponsored content pays for your inference.",
  "version": "0.1.0",
  "private": true,
  "publisher": "aam",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiMarketplace",
          "title": "GRAPE AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiMarketplace": [
        {
          "type": "webview",
          "id": "aiMarketplace.account",
          "name": "Account & Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "aiMarketplace.signIn",
        "title": "GRAPE AI: Sign In"
      },
      {
        "command": "aiMarketplace.signOut",
        "title": "GRAPE AI: Sign Out"
      },
      {
        "command": "aiMarketplace.enterCode",
        "title": "GRAPE AI: Paste Sign-In Code"
      },
      {
        "command": "aiMarketplace.openChat",
        "title": "GRAPE AI: Open Chat"
      },
      {
        "command": "aiMarketplace.newChat",
        "title": "GRAPE AI: New Chat"
      },
      {
        "command": "aiMarketplace.explainSelection",
        "title": "GRAPE AI: Explain Selection"
      },
      {
        "command": "aiMarketplace.openDashboard",
        "title": "GRAPE AI: Open Dashboard"
      },
      {
        "command": "aiMarketplace.topUp",
        "title": "GRAPE AI: Add Credits"
      },
      {
        "command": "aiMarketplace.withdraw",
        "title": "GRAPE AI: Withdraw Earnings"
      },
      {
        "command": "aiMarketplace.openAccount",
        "title": "GRAPE AI: Open Account & Sessions"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiMarketplace.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "GRAPE AI",
      "properties": {
        "aiMarketplace.apiUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Base URL of the GRAPE AI API."
        },
        "aiMarketplace.includeSelection": {
          "type": "boolean",
          "default": true,
          "description": "Send the current editor selection with your question. Selections are used to answer you and are never stored or shared with advertisers."
        },
        "aiMarketplace.maxToolSteps": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 40,
          "description": "How many tool steps the assistant may take before it must answer. Each step is a separate billed request, so this is the ceiling on what one question can cost."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "reinstall": "node scripts/reinstall.mjs"
  },
  "dependencies": {
    "@aam/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
