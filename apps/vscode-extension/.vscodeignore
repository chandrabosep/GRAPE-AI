# Only the bundles and the manifest need to ship; esbuild has already inlined
# everything the extension host and the webview need.
src/**
webview/**
test/**
scripts/**
.turbo/**
.vscode/**
node_modules/**
esbuild.mjs
tsconfig.json
vitest.config.ts
**/*.vsix
# Source maps are dead weight in a published build and leak the whole source
# tree. A --production build emits none; this is the belt to that suspenders.
**/*.map
**/*.ts
**/*.tsx
