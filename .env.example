# =============================================================================
# AI Attention Marketplace — environment
# Copy to .env and fill in. Never commit .env.
# Every secret here is server-side only; the extension and browser get none of them.
# =============================================================================

# --- Database (Supabase) -----------------------------------------------------
# Two URLs, and they are not interchangeable.
#
#   DATABASE_URL  the app's connection, through the transaction pooler (6543).
#   DIRECT_URL    the Prisma CLI's connection, for migrations only.
#
# Migrations take advisory locks, which pgbouncer in transaction mode does not
# hold across statements — pointing DIRECT_URL at 6543 fails in a way that reads
# like a hung migration rather than a misconfiguration.
#
# Copy both strings from the Supabase dashboard's Connect panel rather than
# filling in the templates below by hand; it prints the exact host for the
# project, which the templates cannot.
#
# Known failure: a project's *direct* connection (db.PROJECT_REF.supabase.co) is
# reachable over IPv6 only unless the IPv4 add-on is enabled, so on an IPv4-only
# network or CI runner `db:deploy` fails with ENETUNREACH / "could not connect".
# The fix is the **session** pooler (port 5432 on the pooler host, username
# postgres.PROJECT_REF) for DIRECT_URL — it holds a connection for the whole
# session, so migrations work through it.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Caps the app's connection pool. Set to 1 ONLY for PGlite, which serves one
# connection at a time. Leave it unset against Supabase: a pool of 1 serialises
# every request in the app behind a single connection, which looks like the
# whole product being slow rather than like a setting.
# PRISMA_POOL_MAX=1

# Fully local instead: `pnpm db:dev` serves PGlite on 127.0.0.1:55432,
# persisted in ./.pglite. Integration tests do not use any of this — they start
# their own in-process PGlite and apply the migrations directly.
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"
# PRISMA_POOL_MAX=1

# Reserved for Supabase Storage (ad creative images). Nothing reads these yet:
# a creative's imageUrl is a URL the advertiser supplies, and there is no upload
# path. Leave them blank until that is built.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- App secrets -------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=""
# Guards /api/internal/* (settlement, signal refresh).
ADMIN_TOKEN=""

# --- AWS Bedrock -------------------------------------------------------------
AWS_REGION="us-east-1"
# Simplest option: a long-lived Bedrock API key ("ABSK..."), which authenticates
# with a bearer token and needs no AWS profile, SSO login or instance role.
BEDROCK_API_KEY=""
# Leave BEDROCK_API_KEY empty to fall back to the default AWS provider chain.
# AWS_PROFILE=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
#
# These models have no in-region id; the us. inference profile is required.
# They must also be enabled for your account — an id that exists in
# ListFoundationModels but has not been granted still returns 403.
# Every model listed here needs a matching entry in economics.json, or the chat
# endpoint refuses the request rather than serving inference it cannot price.
BEDROCK_CHAT_MODEL="us.anthropic.claude-sonnet-4-6"
BEDROCK_PREMIUM_MODEL="us.anthropic.claude-opus-4-5-20251101-v1:0"
BEDROCK_CLASSIFIER_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# Set to "fake" to run the whole stack with no AWS call and no spend.
AI_PROVIDER="bedrock"

# --- Wallet sign-in ----------------------------------------------------------
# Sign-In With Ethereum needs no server credentials at all. Injected wallets
# (MetaMask, Rabby, ...) work out of the box.
# WalletConnect, for scanning with a phone wallet.
# Free project id from https://dashboard.walletconnect.com
# Without it, browser-wallet sign-in still works; only the QR option is disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Turns off the seeded development sign-in. It is refused in production anyway.
DISABLE_DEV_AUTH="false"

# --- The Graph ---------------------------------------------------------------
# Subgraph Studio key: https://thegraph.com/studio/ (100k free queries/month).
GRAPH_GATEWAY_API_KEY=""
# Token API (served by Pinax): https://app.pinax.network/keys or thegraph.market
PINAX_API_JWT=""
PINAX_API_URL="https://api.pinax.network"

# --- Onchain (campaign funding + reward payout) ------------------------------
# Hedera testnet EVM, via the HashIO JSON-RPC relay. One chain for the whole
# project: the same network the x402 agent payments settle on.
# USDC is HTS token 0.0.429274, reachable through the ERC-20 interface at its
# EVM alias below — 6 decimals, so the ledger's micro-USD integers map 1:1 onto
# token base units with no conversion anywhere.
# Verified against the live RPC: eth_chainId 0x128, decimals() 6, symbol USDC.
CHAIN_ID="296"
RPC_URL="https://testnet.hashio.io/api"
EXPLORER_URL="https://hashscan.io/testnet"
USDC_ADDRESS="0x0000000000000000000000000000000000001549"
CAMPAIGN_VAULT_ADDRESS=""
REWARD_POOL_ADDRESS=""
# Backend operator that calls settle()/payout(). Testnet key only.
# Top-ups are verified on the mirror node, which speaks Hedera ids.
TREASURY_ACCOUNT_ID=""
USDC_TOKEN_ID="0.0.5449"
OPERATOR_PRIVATE_KEY=""

# --- Contract deployment (read by contracts/script/Deploy.s.sol) -------------
# Gas on Hedera is paid in HBAR; fund a deployer at https://portal.hedera.com
PRIVATE_KEY=""
OPERATOR_ADDRESS=""
PLATFORM_WALLET=""
TREASURY_WALLET=""

# --- Hedera x402 -------------------------------------------------------------
# ECDSA testnet accounts from https://portal.hedera.com
HEDERA_SERVICE_ACCOUNT_ID="0.0.xxxxx"
HEDERA_SERVICE_PRIVATE_KEY=""
HEDERA_AGENT_ACCOUNT_ID="0.0.xxxxx"
HEDERA_AGENT_PRIVATE_KEY=""
# Blocky402 is required by the Hedera prize; x402.org is the fallback facilitator.
X402_FACILITATOR_URL="https://api.testnet.blocky402.com"
X402_NETWORK="hedera:testnet"
X402_PRICE_HBAR_TINYBARS="1000000"
X402_API_PORT="4402"

# --- URLs --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_PRIVY_APP_ID=""
NEXT_PUBLIC_CHAIN_ID="296"
# Where the x402 service answers. The /agents docs page quotes this, and
# discovery advertises it, so it must be the address agents can reach —
# a tunnel (ngrok et al) while developing, the deployment once there is one.
X402_API_URL="http://localhost:4402"

